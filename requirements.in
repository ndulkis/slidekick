# Direct dependencies only. Edit this file, never requirements.lock.
#
# After any change here:
#
#     pip-compile --no-index --output-file=requirements.lock --strip-extras requirements.in
#     pip install -r requirements.lock    # reinstall into your .venv
#
# Versions are left unpinned here on purpose — requirements.lock is what pins
# them, and the lock is what .venv and CI install.

# Core
numpy

# Headless build: CI runners have no display, and this avoids pulling in GUI
# system libraries.
opencv-python-headless

# MediaPipe provides the hand landmark and gesture recognition pipeline used by
# SlideKick for static gesture classification and landmark-based motion tracking.
mediapipe<1

# Test and lint tooling
pytest
ruff

# Provides pip-compile for regenerating requirements.lock.
pip-tools
