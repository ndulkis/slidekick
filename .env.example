# SlideKick configuration.
#
# Every setting is optional. To override one locally, copy this file to `.env`
# (which git ignores) and uncomment the lines you need:
#
#     macOS:    cp .env.example .env
#     Windows:  copy .env.example .env
#
# Real environment variables take precedence over `.env`.
# src/slidekick/config.py reads and validates these settings.

# --- General -----------------------------------------------------------------

# development | test | production
# SLIDEKICK_ENV=development

# DEBUG | INFO | WARNING | ERROR
# SLIDEKICK_LOG_LEVEL=INFO

# Gesture model, relative to the repo root.
# SLIDEKICK_MODEL_PATH=models/gesture_recognizer.task

# --- Camera ------------------------------------------------------------------

# Which webcam to use. 0 is the default camera; try 1, 2, ... for others.
# SLIDEKICK_CAMERA_INDEX=0

# How OpenCV talks to the camera. The default depends on your OS:
#   macOS:    avfoundation (default) | any
#   Windows:  msmf (default) | dshow | any
#   Linux:    v4l2 (default) | any
# On Windows, try dshow if the camera is slow to open or shows a black frame.
# SLIDEKICK_CAMERA_BACKEND=

# --- Secrets -----------------------------------------------------------------
#
# SlideKick doesn't need any secrets yet. When it does (API keys, tokens), list
# the variable name here with an empty value, never a real one. CI gets the real
# value from GitHub Actions secrets (Settings > Secrets and variables > Actions).
